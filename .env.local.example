# =============================================================
# SUPABASE — Public (safe to expose in browser)
# =============================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# =============================================================
# SUPABASE — Secret (server-side only, bypasses RLS)
# =============================================================
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# =============================================================
# DRIZZLE ORM — Runtime database connection
# Use: Transaction Mode pooler (port 6543) — for serverless/Next.js
# Find under: Supabase Dashboard → Project Settings → Database → Connection string
# Set { prepare: false } in drizzle client (already done in src/db/index.ts)
# =============================================================
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# =============================================================
# DRIZZLE-KIT — Migration-only direct connection
# Use: Session Mode / Direct (port 5432) — for drizzle-kit generate/migrate
# =============================================================
DATABASE_URL_DIRECT=postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# =============================================================
# APP URL (used for generating live tracking links)
# =============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================
# SMS GATEWAY PROVIDER: 'TWILIO', 'SSL_WIRELESS', or 'MOCK'
# =============================================================
SMS_PROVIDER=MOCK

# --- Twilio Configuration (if SMS_PROVIDER=TWILIO) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# --- SSL Wireless Bangladesh (if SMS_PROVIDER=SSL_WIRELESS) ---
SSL_WIRELESS_API_TOKEN=your_ssl_wireless_api_token
SSL_WIRELESS_SID=your_ssl_wireless_sid
SSL_WIRELESS_DOMAIN=https://smsplus.sslwireless.com
